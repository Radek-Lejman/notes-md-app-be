// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, unaccent]
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  notes        Note[]
  RefreshToken RefreshToken[]
  aiCredential AiCredential?
}

/// The user's own Claude credential (subscription OAuth token or Console API key).
model AiCredential {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'claude-oauth-token' | 'anthropic-api-key'
  type      String
  /// AES-256-GCM ciphertext bound to userId (see SecretBox); never returned by the API.
  secret    String
  /// Last characters of the secret, shown in the UI.
  hint      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NoteVersion {
  id            String   @id @default(uuid())
  note          Note     @relation(fields: [noteId], references: [id])
  noteId        String
  content       String // markdown snapshot
  /// Pre-markdown Tiptap JSON, kept for rollback. Drop once the migration is confirmed.
  contentLegacy Json?    @map("content_legacy")
  createdAt     DateTime @default(now())
}

model Note {
  id            String   @id @default(uuid())
  title         String
  content       String // markdown
  /// Pre-markdown Tiptap JSON, kept for rollback. Drop once the migration is confirmed.
  contentLegacy Json?    @map("content_legacy")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  parent   Note?   @relation("NoteToChildren", fields: [parentId], references: [id])
  parentId String?
  children Note[]  @relation("NoteToChildren")

  versions NoteVersion[]
  chunks   NoteChunk[]

  /// `updatedAt` of the version embedded for RAG; null/older = needs (re)indexing.
  ragIndexedAt DateTime?
}

/// RAG: a piece of a note with its embedding. Written with raw SQL (vector column).
model NoteChunk {
  id          String                @id @default(uuid())
  noteId      String
  note        Note                  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId      String
  chunkIndex  Int
  /// "Title > Heading > Subheading" of the chunk.
  headingPath String
  content     String
  /// Embedding model; vectors of other models are ignored and re-indexed.
  model       String
  embedding   Unsupported("vector")
  createdAt   DateTime              @default(now())

  @@index([userId, model])
  @@index([noteId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

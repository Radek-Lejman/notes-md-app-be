# =====================================================================
# Database / auth
# =====================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Docker network host is "db"; when running the backend locally use localhost:5433.
DATABASE_URL=postgres://admin:secret@db:5432/myapp
JWT_ACCESS_SECRET=change-me-at-least-32-bytes-long-secret
JWT_ACCESS_EXPIRE_IN=15
JWT_REFRESH_SECRET=change-me-at-least-32-bytes-long-secret-2
JWT_REFRESH_EXPIRE_IN=14

# =====================================================================
# AI assistant — providers & models
# =====================================================================
# Chat/agent engine: claude-agent-sdk (Claude, per-user account) | ollama (local, free)
AI_AGENT_PROVIDER=claude-agent-sdk
# Simple completions (/api/ai/complete): claude-cli | ollama
AI_PROVIDER=claude-cli
# Claude model alias or id: sonnet | opus | haiku | claude-sonnet-5-5 ...
AI_CLAUDE_MODEL=sonnet
# Tool-calling steps per answer (1-30) and time limits
AI_AGENT_MAX_TURNS=8
AI_AGENT_TIMEOUT_MS=180000
AI_TIMEOUT_MS=90000
# Agent's search_notes: keywords + snippets (true) or the basic one-phrase search (false)
AI_AGENT_KEYWORD_SEARCH=true
# AI_CLAUDE_CLI_BIN=claude

# Local models (agent when AI_AGENT_PROVIDER=ollama, and RAG embeddings)
AI_OLLAMA_URL=http://localhost:11434
# Ollama URL for the backend running in docker compose (default: the host machine)
# AI_OLLAMA_URL_DOCKER=http://host.docker.internal:11434
AI_OLLAMA_MODEL=qwen3:30b-a3b
AI_OLLAMA_TIMEOUT_MS=180000
# AI_OLLAMA_THINK=

# =====================================================================
# AI assistant — accounts & security
# =====================================================================
# Every user connects their OWN Claude account in the app (AI settings):
#   - subscription token from `claude setup-token` (sk-ant-oat01-...), or
#   - Anthropic Console API key (sk-ant-api03-..., pay-as-you-go).
# Secrets are encrypted with this key (AES-256-GCM). Required in production.
# Generate: openssl rand -base64 48      (changing it invalidates saved credentials)
AI_CREDENTIALS_SECRET=change-me-at-least-32-bytes-long-secret-3
# Comma-separated app emails allowed to use THIS machine's `claude` login when they
# saved no credential (e.g. the owner of the server). Empty = nobody.
AI_SERVER_LOGIN_EMAILS=

# Limits (per backend instance)
AI_MAX_CONCURRENT_RUNS=3
AI_MAX_CONCURRENT_RUNS_PER_USER=1
AI_CHAT_RATE_LIMIT_PER_MIN=20
AI_RATE_LIMIT_PER_MIN=5

# =====================================================================
# RAG (semantic search over notes; pgvector + local embeddings)
# =====================================================================
RAG_ENABLED=true
# Embeddings: ollama (separate Ollama server) | local (in-process model, no extra service;
# notes never leave the backend). Changing the provider or model re-indexes all notes.
RAG_EMBEDDING_PROVIDER=ollama
# Ollama model (`ollama pull bge-m3`). bge-m3 = multilingual (good for Polish).
RAG_EMBEDDING_MODEL=bge-m3
# local: Hugging Face ONNX model, downloaded on first use (~120 MB). It runs in a child process
# (~0.8-1 GB RAM) that exits after RAG_LOCAL_IDLE_MS without requests and restarts in ~0.5 s.
# e5 models score unrelated text high (~0.8): raise RAG_MIN_SCORE when switching to them.
# RAG_LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# RAG_LOCAL_MODEL_DIR=        # model cache; default: inside node_modules
# RAG_LOCAL_IDLE_MS=600000
# RAG_OLLAMA_URL=            # defaults to AI_OLLAMA_URL
RAG_EMBEDDING_TIMEOUT_MS=60000
# Chunking (characters; ~4 chars per token)
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=200
# Retrieval: results of the semantic_search tool, minimum cosine similarity (0-1),
# fragments put into the prompt up front for every question (0 = tool only)
RAG_TOP_K=6
RAG_MIN_SCORE=0.45
RAG_AUTO_CONTEXT_K=4
# Hybrid search: fuse semantic results with keyword (full-text) matches of the same question
# (Reciprocal Rank Fusion). Helps with names, numbers and exact words. false = semantic only.
RAG_HYBRID=true
# Background indexing: check interval, wait after the last edit, notes per round
RAG_INDEX_INTERVAL_MS=30000
RAG_INDEX_DEBOUNCE_MS=10000
RAG_INDEX_BATCH_SIZE=20
